{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.thetvbox.mobile",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.thetvbox.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.thetvbox.mobile",
          "widgets": [
            {
              "name": "NextEpisodeWidget",
              "displayName": "Continue Watching",
              "description": "Shows the next episode of the show you're currently watching.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      "./plugins/withDisableUserScriptSandboxing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.thetvbox.mobile.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.thetvbox.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "601dab96-35d0-4f13-b684-42afa1c895dc"
      }
    },
    "owner": "tv-box"
  }
}
